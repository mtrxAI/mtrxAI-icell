# Inference backend: llamacpp (default) or ollama (use compose profile: docker compose --profile ollama up)
INFERENCE_BACKEND=llamacpp

# --- llama.cpp image (when INFERENCE_BACKEND=llamacpp) ---
# CPU:  ghcr.io/ggml-org/llama.cpp:server
# GPU:  ghcr.io/ggml-org/llama.cpp:server-cuda
LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server

# --- Ollama image (when INFERENCE_BACKEND=ollama) ---
OLLAMA_IMAGE=ollama/ollama:latest

# Local tags after build
CELL_IMAGE=mtrxai-icell:local
CELL_OLLAMA_IMAGE=mtrxai-icell-ollama:local

# Optional: admin token for /mtrxai/v1/models/* (empty = no auth on pull routes)
CELL_ADMIN_TOKEN=

# Optional: Hugging Face token for gated models
HF_TOKEN=

# Optional: llama-server API key (llamacpp only)
LLAMA_API_KEY=

# Host port mapped to inference cell HTTPS
HTTPS_PUBLISH_PORT=8443

# Directory on the host with GGUF models (llamacpp autoload / ollama HF staging)
MODELS_HOST_PATH=./models

# Ollama blob store lives under /models/.ollama inside the container
OLLAMA_ORIGINS=*
DELETE_GGUF_AFTER_IMPORT=false

# In-memory TLS self-signed certificate rotation interval (seconds)
TLS_ROTATE_SECS=3600
TLS_CERT_CN=llama-inference.local

# Max concurrent loaded models — llamacpp router only (0 = unlimited)
MODELS_MAX=4

# Max download size for HF pull (bytes, default 80 GiB)
MODEL_MAX_BYTES=85899345920

# After HF pull, load/warmup model automatically
AUTO_LOAD_AFTER_PULL=true

# Extra llama-server flags (GPU example with server-cuda image):
# LLAMA_EXTRA_ARGS=--n-gpu-layers 99
